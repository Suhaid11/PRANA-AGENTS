# PRANA Environment Configuration Template (Phase 17 Prototype)
# Copy to .env for local development overrides

PROJECT_NAME="PRANA Emergency Coordination Backend"
DATABASE_URL="sqlite:///./prana.db"
JWT_SECRET="prana-dev-secret-key-phase16-unbroken-care"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Provider & Agentic Orchestrator Configuration (Phase 17-19)
# AI_PROVIDER options: demo (default, deterministic), real (OpenAI/Anthropic/Local LLM)
AI_PROVIDER="demo"
AI_PROVIDER_VERSION="2.0.0-agentic"
AI_MODEL_NAME="gpt-4o-mini"
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_SECONDS=8.0
AI_FAIL_OPEN=true
AI_FALLBACK_PROVIDER="demo"

# Agentic Execution Boundaries
AI_MAX_AGENT_ITERATIONS=5
AI_MAX_TOOL_CALLS=6
AI_AGENT_TIMEOUT_SECONDS=10.0
AI_PROMPT_VERSION="PRANA_AGENT_SYSTEM_V1"

