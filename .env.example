# PRANA Prehospital Emergency Coordination Platform — Environment Configuration Template
# Copy this file to .env or backend/.env to override defaults for your environment

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_API_HEALTH_URL="http://127.0.0.1:8000/health"

# ==========================================
# Backend Service Configuration
# ==========================================
PROJECT_NAME="PRANA Emergency Coordination Backend"
DATABASE_URL="sqlite:///./prana.db"
JWT_SECRET="prana-dev-secret-key-phase16-unbroken-care"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ==========================================
# AI Provider & Extraction Configuration (Phase 23.2)
# ==========================================
# Extractor provider priority: qwen3 -> deterministic fallback
PRANA_AI_BASE_URL="http://127.0.0.1:11434"
PRANA_AI_MODEL="qwen3:8b"
PRANA_AI_VERIFY_IDENTITY=true
PRANA_AI_TIMEOUT_SECONDS=15.0

# Speech-to-Text (STT) Configuration
# Options: faster-whisper (local/server), browser-speech (client Web Speech API)
PRANA_STT_PROVIDER="faster-whisper"
PRANA_STT_MODEL="base.en"
PRANA_MAX_AUDIO_MB=25

# Agentic Decision Support & Orchestration
AI_PROVIDER="local"
AI_PROVIDER_VERSION="2.0.0-agentic"
AI_MODEL_NAME="qwen3:8b"
AI_API_BASE_URL="http://127.0.0.1:11434"
AI_API_KEY=""
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_SECONDS=10.0
AI_FAIL_OPEN=true
AI_FALLBACK_PROVIDER="demo"

# Agentic Execution Boundaries
AI_MAX_AGENT_ITERATIONS=5
AI_MAX_TOOL_CALLS=6
AI_AGENT_TIMEOUT_SECONDS=10.0
AI_PROMPT_VERSION="PRANA_AGENT_SYSTEM_V1"
